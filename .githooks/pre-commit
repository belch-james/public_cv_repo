#!/bin/sh
# Pre-commit hook for secret detection
# Install: git config core.hooksPath .githooks

# Check for common secret patterns in staged files
PATTERNS='(AKIA[0-9A-Z]{16}|sk_live_|pk_live_|-----BEGIN.*PRIVATE KEY|password\s*=\s*["\047][^"\047]+["\047]|api[_-]?key\s*=\s*["\047][^"\047]+["\047])'

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check each staged file for secrets
FOUND=0
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        MATCHES=$(grep -nE "$PATTERNS" "$FILE" 2>/dev/null || true)
        if [ -n "$MATCHES" ]; then
            echo "Potential secret found in $FILE:"
            echo "$MATCHES"
            FOUND=1
        fi
    fi
done

if [ $FOUND -eq 1 ]; then
    echo ""
    echo "Commit blocked: potential secrets detected."
    echo "If these are false positives, use: git commit --no-verify"
    exit 1
fi

exit 0
